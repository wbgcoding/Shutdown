<Window x:Class="Shutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Shutdown.Core"
        xmlns:ui="clr-namespace:Shutdown.Ui"
        Title="Shutdown" Width="360" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="MainWindow">
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo/>
  </Window.TaskbarItemInfo>
  <!-- The app draws its own title bar; dragging, snapping and the system menu (Alt+Space) stay native. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <DockPanel>
  <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="44">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <ui:AppLogo Width="24" Height="24" Margin="12,0,9,0" VerticalAlignment="Center"/>
    <!-- Hidden from screen readers: the window itself carries the same name. -->
    <ui:Glyph Grid.Column="1" Style="{StaticResource TitleText}"
               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <Button x:Name="MinimizeButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Click="OnMinimize"
            AutomationProperties.AutomationId="TitleMinimize"
            AutomationProperties.Name="{Binding [TitleMinimize], Source={x:Static core:Loc.I}}">
      <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
    </Button>
    <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CaptionCloseButton}" Click="OnCloseButton"
            AutomationProperties.AutomationId="TitleClose"
            AutomationProperties.Name="{Binding [TitleClose], Source={x:Static core:Loc.I}}">
      <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
    </Button>
  </Grid>
  <StackPanel Margin="12,0,12,10">

    <!-- Action and time -->
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
      <StackPanel>
        <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,8">
          <ui:SelectionSlider><UniformGrid Rows="2" Columns="2">
            <RadioButton x:Name="ActShutdown" GroupName="Action" Style="{StaticResource Segment}" Checked="OnInputChanged"
                         AutomationProperties.AutomationId="ActShutdown"
                         ToolTip="{Binding [TipShutdown], Source={x:Static core:Loc.I}}"
                         AutomationProperties.HelpText="{Binding [TipShutdown], Source={x:Static core:Loc.I}}"
                         AutomationProperties.Name="{Binding [ActShutdown], Source={x:Static core:Loc.I}}">
              <StackPanel Orientation="Horizontal">
                <ui:PowerGlyph Margin="0,0,5,0"/>
                <TextBlock Text="{Binding [ActShutdown], Source={x:Static core:Loc.I}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ActRestart" GroupName="Action" Style="{StaticResource Segment}" Checked="OnInputChanged"
                         AutomationProperties.AutomationId="ActRestart"
                         ToolTip="{Binding [TipRestart], Source={x:Static core:Loc.I}}"
                         AutomationProperties.HelpText="{Binding [TipRestart], Source={x:Static core:Loc.I}}"
                         AutomationProperties.Name="{Binding [ActRestart], Source={x:Static core:Loc.I}}">
              <StackPanel Orientation="Horizontal">
                <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding [ActRestart], Source={x:Static core:Loc.I}}"/>
              </StackPanel>
            </RadioButton>
            <Grid>
              <RadioButton x:Name="ActHibernate" GroupName="Action" Checked="OnInputChanged"
                           AutomationProperties.AutomationId="ActHibernate"
                           AutomationProperties.Name="{Binding [ActHibernate], Source={x:Static core:Loc.I}}">
                <RadioButton.Style>
                  <Style TargetType="RadioButton" BasedOn="{StaticResource Segment}">
                    <Setter Property="ToolTip" Value="{Binding [TipHibernate], Source={x:Static core:Loc.I}}"/>
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding [TipHibernate], Source={x:Static core:Loc.I}}"/>
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Padding" Value="4,4,28,4"/>
                        <Setter Property="ToolTip" Value="{Binding [HibernateUnavailable], Source={x:Static core:Loc.I}}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding [HibernateUnavailable], Source={x:Static core:Loc.I}}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </RadioButton.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE708;" FontSize="13" Margin="0,0,5,0"/>
                  <TextBlock Text="{Binding [ActHibernate], Source={x:Static core:Loc.I}}"/>
                </StackPanel>
              </RadioButton>
              <Button Width="24" Height="24" MinHeight="24" Padding="0" Margin="0,0,2,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="OnActionInfoClick" MouseLeave="OnActionInfoDismiss"
                      LostKeyboardFocus="OnActionInfoDismiss" PreviewKeyDown="OnActionInfoKeyDown"
                      AutomationProperties.AutomationId="HibernateInfo"
                      AutomationProperties.Name="{Binding [HibernateUnavailable], Source={x:Static core:Loc.I}}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEnabled, ElementName=ActHibernate}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.ToolTip>
                  <ToolTip Placement="Bottom" Content="{Binding [HibernateUnavailable], Source={x:Static core:Loc.I}}"/>
                </Button.ToolTip>
                <ui:InfoBadge/>
              </Button>
            </Grid>
            <Grid>
              <RadioButton x:Name="ActSleep" GroupName="Action" Checked="OnInputChanged"
                           AutomationProperties.AutomationId="ActSleep"
                           AutomationProperties.Name="{Binding [ActSleep], Source={x:Static core:Loc.I}}">
                <RadioButton.Style>
                  <Style TargetType="RadioButton" BasedOn="{StaticResource Segment}">
                    <Setter Property="ToolTip" Value="{Binding [TipSleep], Source={x:Static core:Loc.I}}"/>
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding [TipSleep], Source={x:Static core:Loc.I}}"/>
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Padding" Value="4,4,28,4"/>
                        <Setter Property="ToolTip" Value="{Binding [SleepUnavailable], Source={x:Static core:Loc.I}}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding [SleepUnavailable], Source={x:Static core:Loc.I}}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </RadioButton.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:IconGlyph x:Name="SleepIcon" Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,5,0"/>
                  <TextBlock Text="{Binding [ActSleep], Source={x:Static core:Loc.I}}"/>
                </StackPanel>
              </RadioButton>
              <Button Width="24" Height="24" MinHeight="24" Padding="0" Margin="0,0,2,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="OnActionInfoClick" MouseLeave="OnActionInfoDismiss"
                      LostKeyboardFocus="OnActionInfoDismiss" PreviewKeyDown="OnActionInfoKeyDown"
                      AutomationProperties.AutomationId="SleepInfo"
                      AutomationProperties.Name="{Binding [SleepUnavailable], Source={x:Static core:Loc.I}}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEnabled, ElementName=ActSleep}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.ToolTip>
                  <ToolTip Placement="Bottom" Content="{Binding [SleepUnavailable], Source={x:Static core:Loc.I}}"/>
                </Button.ToolTip>
                <ui:InfoBadge/>
              </Button>
            </Grid>
          </UniformGrid></ui:SelectionSlider>
        </Border>

        <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,10">
          <ui:SelectionSlider><UniformGrid Rows="1">
            <RadioButton x:Name="ModeCountdown" GroupName="Mode" Style="{StaticResource Segment}" Checked="OnInputChanged"
                         AutomationProperties.AutomationId="ModeCountdown"
                         ToolTip="{Binding [TipCountdown], Source={x:Static core:Loc.I}}"
                         AutomationProperties.HelpText="{Binding [TipCountdown], Source={x:Static core:Loc.I}}"
                         AutomationProperties.Name="{Binding [ModeCountdown], Source={x:Static core:Loc.I}}">
              <StackPanel Orientation="Horizontal">
                <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE916;" FontSize="13" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding [ModeCountdown], Source={x:Static core:Loc.I}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeAt" GroupName="Mode" Style="{StaticResource Segment}" Checked="OnInputChanged"
                         AutomationProperties.AutomationId="ModeAt"
                         ToolTip="{Binding [TipAt], Source={x:Static core:Loc.I}}"
                         AutomationProperties.HelpText="{Binding [TipAt], Source={x:Static core:Loc.I}}"
                         AutomationProperties.Name="{Binding [ModeAt], Source={x:Static core:Loc.I}}">
              <StackPanel Orientation="Horizontal">
                <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE787;" FontSize="13" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding [ModeAt], Source={x:Static core:Loc.I}}"/>
              </StackPanel>
            </RadioButton>
          </UniformGrid></ui:SelectionSlider>
        </Border>

        <!-- Day for a date -->
        <!-- Today and Tomorrow share one width, so the date between the arrows sits exactly in the middle. -->
        <Grid x:Name="DateRow" Visibility="Collapsed" Margin="0,0,0,8" Grid.IsSharedSizeScope="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="DayChip"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="DayChip"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource ChipButton}" Click="OnToday" AutomationProperties.AutomationId="Today"
                  Content="{Binding [Today], Source={x:Static core:Loc.I}}" Margin="0,0,6,0"/>
          <Button x:Name="PrevDay" Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnPrevDay" MinWidth="32" MinHeight="32"
                  AutomationProperties.AutomationId="PrevDay"
                  AutomationProperties.Name="{Binding [PrevDay], Source={x:Static core:Loc.I}}"
                  ToolTip="{Binding [PrevDay], Source={x:Static core:Loc.I}}">
            <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12"/>
          </Button>
          <!-- A long English date ("Wed, 12/30/2026") wraps after the weekday instead of being cut off. -->
          <TextBlock x:Name="DateLabel" Grid.Column="2" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="DateLabel"/>
          <Button x:Name="NextDay" Grid.Column="3" Style="{StaticResource GhostButton}" Click="OnNextDay" MinWidth="32" MinHeight="32"
                  AutomationProperties.AutomationId="NextDay"
                  AutomationProperties.Name="{Binding [NextDay], Source={x:Static core:Loc.I}}"
                  ToolTip="{Binding [NextDay], Source={x:Static core:Loc.I}}">
            <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12"/>
          </Button>
          <Button Grid.Column="4" Style="{StaticResource ChipButton}" Click="OnTomorrow" AutomationProperties.AutomationId="Tomorrow"
                  Content="{Binding [Tomorrow], Source={x:Static core:Loc.I}}" Margin="6,0,0,0"/>
        </Grid>

        <!-- The value the other mode would show: end time for a countdown, time left for a date -->
        <TextBlock x:Name="ResultText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource Text}"
                   AutomationProperties.AutomationId="ResultText" AutomationProperties.LiveSetting="Polite"/>

        <!-- Countdown -->
        <StackPanel x:Name="CountdownPanel" Orientation="Horizontal" HorizontalAlignment="Center">
          <ui:NumberSpinner x:Name="DurHours" Maximum="999" Digits="1" AutomationKey="DurHours"/>
          <TextBlock Text=":" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextSub}"
                     VerticalAlignment="Top" Margin="8,22.5,8,0"/>
          <ui:NumberSpinner x:Name="DurMinutes" Maximum="59" TypedMaximum="5999" MaxLength="4"
                            CarryInsteadOfWrap="True" Digits="2" AutomationKey="DurMinutes"/>
        </StackPanel>

        <!-- Time of day -->
        <StackPanel x:Name="AtPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
          <ui:NumberSpinner x:Name="AtHour" Maximum="23" Wrap="True" Digits="2" AutomationKey="AtHour"/>
          <TextBlock Text=":" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextSub}"
                     VerticalAlignment="Top" Margin="8,22.5,8,0"/>
          <ui:NumberSpinner x:Name="AtMinute" Maximum="59" Wrap="True" Digits="2" AutomationKey="AtMinute"/>
        </StackPanel>

        <ui:SelectionSlider HorizontalAlignment="Center" Margin="0,8,0,-6" ItemFill="{DynamicResource Control}"
                            ItemBorder="{DynamicResource ControlBorder}"
                            Visibility="{Binding Visibility, ElementName=Chips}">
          <WrapPanel x:Name="Chips" Margin="0,0,-6,0"/>
        </ui:SelectionSlider>
        <Border x:Name="AppTimedNote" Background="{DynamicResource Control}" BorderBrush="{DynamicResource Accent}"
                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:InfoBadge Margin="0,0,10,0"/>
            <TextBlock x:Name="AppTimedText" Grid.Column="1" FontSize="12" Foreground="{DynamicResource Text}"
                       VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="AppTimedNote"/>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- Pending -->
    <Border x:Name="PendingCard" Visibility="Collapsed" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
            AutomationProperties.AutomationId="PendingCard">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="PendingTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="PendingTitle"/>
          <TextBlock x:Name="PendingWhen" FontSize="12" Foreground="{DynamicResource TextSub}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="PendingWhen"/>
          <TextBlock x:Name="PendingKeepOpen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSub}" TextWrapping="Wrap"
                     Margin="0,2,0,0" Text="{Binding [PendingKeepOpen], Source={x:Static core:Loc.I}}"/>
        </StackPanel>
        <TextBlock x:Name="PendingClock" Grid.Column="1" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                   FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                   Margin="10,0,0,0" AutomationProperties.AutomationId="PendingClock" AutomationProperties.LiveSetting="Assertive"/>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
          <Button x:Name="Extend15Button" DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Margin="0,0,6,0"
                  Click="OnExtend15" AutomationProperties.AutomationId="Extend15"
                  AutomationProperties.Name="{Binding [Postpone15], Source={x:Static core:Loc.I}}"/>
          <Button x:Name="Extend60Button" DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Margin="0"
                  Click="OnExtend60" AutomationProperties.AutomationId="Extend60"
                  AutomationProperties.Name="{Binding [Postpone60], Source={x:Static core:Loc.I}}"/>
          <Button x:Name="AbortButton" Style="{StaticResource GhostButton}" Click="OnAbort"
                  HorizontalAlignment="Right" AutomationProperties.AutomationId="Abort"
                  AutomationProperties.Name="{Binding [Abort], Source={x:Static core:Loc.I}}">
            <StackPanel Orientation="Horizontal">
              <ui:IconGlyph Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13" Margin="0,2,8,0"/>
              <TextBlock Text="{Binding [Abort], Source={x:Static core:Loc.I}}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Message -->
    <Border x:Name="MessageCard" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
            AutomationProperties.AutomationId="MessageCard">
      <StackPanel>
        <TextBox x:Name="MessageText" Style="{StaticResource ReadOnlyText}"
                 AutomationProperties.AutomationId="MessageText" AutomationProperties.LiveSetting="Assertive"/>
        <TextBox x:Name="MessageDetail" Style="{StaticResource ReadOnlyText}" FontSize="12" Margin="0,2,0,0"
                 FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextSub}"
                 AutomationProperties.AutomationId="MessageDetail"/>
        <WrapPanel x:Name="MessageActions" Margin="0,6,0,-6">
          <Button x:Name="CopyButton" Style="{StaticResource ChipButton}" Click="OnCopyMessage"
                  AutomationProperties.AutomationId="CopyMessage"
                  Content="{Binding [Copy], Source={x:Static core:Loc.I}}"/>
          <Button x:Name="OpenLogButton" Style="{StaticResource ChipButton}" Click="OnOpenLog"
                  AutomationProperties.AutomationId="OpenLog"
                  Content="{Binding [OpenLog], Source={x:Static core:Loc.I}}"/>
          <Button x:Name="CloseAnywayButton" Style="{StaticResource ChipButton}" Click="OnCloseAnyway"
                  AutomationProperties.AutomationId="CloseAnyway"
                  Content="{Binding [CloseAnyway], Source={x:Static core:Loc.I}}"/>
          <Button x:Name="DismissButton" Style="{StaticResource ChipButton}" Click="OnDismissMessage"
                  AutomationProperties.AutomationId="DismissMessage"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="OnStart" MinHeight="36"
            IsDefault="True" AutomationProperties.AutomationId="Start" AutomationProperties.AcceleratorKey="Enter"
            ToolTip="{Binding [StartTip], Source={x:Static core:Loc.I}}">
      <StackPanel Orientation="Horizontal">
        <ui:PowerGlyph x:Name="StartPower" Margin="0,0,8,0"/>
        <ui:IconGlyph x:Name="StartIcon" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Visibility="Collapsed"/>
        <TextBlock x:Name="StartText" TextWrapping="Wrap"/>
      </StackPanel>
    </Button>
  </StackPanel>
  </DockPanel>
</Window>
